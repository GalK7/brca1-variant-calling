rule all:
    input:
        "results/benchmark.txt",
        "results/annotation/variant_summary.tsv"

rule fastp:
    input:
        r1="data/na12878_R1.fastq.gz",
        r2="data/na12878_R2.fastq.gz"
    output:
        r1="results/trimmed/na12878_R1.trimmed.fastq.gz",
        r2="results/trimmed/na12878_R2.trimmed.fastq.gz",
        html="results/qc/fastp.html",
        json="results/qc/fastp.json"
    shell:
        "fastp -i {input.r1} -I {input.r2}   -o {output.r1} -O {output.r2}   --detect_adapter_for_pe   -h {output.html} -j {output.json}"

rule bwa:
    input:
        r1="results/trimmed/na12878_R1.trimmed.fastq.gz",
        r2="results/trimmed/na12878_R2.trimmed.fastq.gz",
        reference="data/chr17.fa"
    output:
        bam="results/aligned/na12878.sorted.bam",
        index="results/aligned/na12878.sorted.bam.bai"
    shell:
        "bwa  mem -t 4 -R '@RG\\tID:na12878\\tSM:NA12878\\tPL:ILLUMINA'   {input.reference}   {input.r1} {input.r2}   | samtools sort -o {output.bam} - && samtools index {output.bam}"
        
rule mark_duplicates:
    input:
        bam="results/aligned/na12878.sorted.bam"
    output:
        bam="results/aligned/na12878.markdup.bam",
        index="results/aligned/na12878.markdup.bam.bai",
        metrics="results/qc/markdup_metrics.txt"
    shell:
        "gatk MarkDuplicates -I {input.bam}   -O {output.bam}   -M {output.metrics} && samtools index {output.bam}"

rule call_bcftools:
    input:
        bam="results/aligned/na12878.markdup.bam",
        index="results/aligned/na12878.markdup.bam.bai",
        reference="data/chr17.fa"
    output:
        vcf="results/variants/na12878.bcftools.vcf.gz",
        tbi="results/variants/na12878.bcftools.vcf.gz.tbi"
    shell:
        "bcftools mpileup -f {input.reference} -r chr17:43030000-43140000 -a FORMAT/AD,FORMAT/DP   {input.bam}   | bcftools call -m -v -Oz -o {output.vcf} && bcftools index -t {output.vcf}"

rule call_gatk:
    input:
        bam="results/aligned/na12878.markdup.bam",
        index="results/aligned/na12878.markdup.bam.bai",
        reference="data/chr17.fa"
    output:
        vcf="results/variants/na12878.gatk.vcf.gz",
        tbi="results/variants/na12878.gatk.vcf.gz.tbi"
    shell:
        "gatk HaplotypeCaller   -R {input.reference}   -I {input.bam}   -L chr17:43030000-43140000   -O {output.vcf}"

rule normalize:
    input:
        vcf="{prefix}.vcf.gz",
        reference="data/chr17.fa"
    output:
        vcf="{prefix}.norm.vcf.gz"
    shell:
        "bcftools norm -f {input.reference} -m -any -Oz -o {output.vcf} {input.vcf}"

rule compare:
    input:
        "results/variants/na12878.bcftools.norm.vcf.gz",
        "results/variants/na12878.gatk.norm.vcf.gz",
        "data/truth_brca1.norm.vcf.gz",
        "data/HG001_benchmark.bed",
        script="scripts/compare_vcf.py"
    output:
        benchmark="results/benchmark.txt"
    shell:
        "python {input.script} > {output.benchmark}"

rule snpeff_db:
    output:
        directory("data/snpeff/GRCh38.mane.1.5.refseq")
    conda:
        "envs/snpeff.yaml"
    shell:
        "snpEff download -dataDir $(pwd)/data/snpeff GRCh38.mane.1.5.refseq"

rule snpeff:
    input:
        vcf="results/variants/na12878.gatk.norm.vcf.gz",
        db="data/snpeff/GRCh38.mane.1.5.refseq"
    output:
        vcf="results/annotation/na12878.gatk.snpeff.vcf.gz",
        tbi="results/annotation/na12878.gatk.snpeff.vcf.gz.tbi",
        html="results/annotation/snpeff_summary.html"
    conda:
        "envs/snpeff.yaml"
    shell:
        "snpEff ann -dataDir $(pwd)/data/snpeff -stats {output.html} GRCh38.mane.1.5.refseq {input.vcf} | bgzip > {output.vcf} && tabix -p vcf {output.vcf}"

rule annotate_gnomad:
    input:
        vcf="results/annotation/na12878.gatk.snpeff.vcf.gz",
        tbi="results/annotation/na12878.gatk.snpeff.vcf.gz.tbi",
        gnomad="data/gnomad_brca1.vcf.gz"
    output:
        vcf="results/annotation/na12878.gatk.gnomad.vcf.gz",
        tbi="results/annotation/na12878.gatk.gnomad.vcf.gz.tbi"
    shell:
        "bcftools annotate -a {input.gnomad} -c INFO/gnomAD_AF:=INFO/AF -Oz -o {output.vcf} {input.vcf} && bcftools index -t {output.vcf}"

rule annotate_clinvar:
    input:
        vcf="results/annotation/na12878.gatk.gnomad.vcf.gz",
        tbi="results/annotation/na12878.gatk.gnomad.vcf.gz.tbi",
        clinvar="data/clinvar_brca1.vcf.gz"
    output:
        vcf="results/annotation/na12878.gatk.final.vcf.gz",
        tbi="results/annotation/na12878.gatk.final.vcf.gz.tbi"
    shell:
        "bcftools annotate -a {input.clinvar} -c INFO/CLNSIG,INFO/CLNREVSTAT -Oz -o {output.vcf} {input.vcf} && bcftools index -t {output.vcf}"

rule variants_table:
    input:
        vcf="results/annotation/na12878.gatk.final.vcf.gz"
    output:
        tsv="results/annotation/variants_table.tsv"
    shell:
        "bcftools query -f '%CHROM\\t%POS\\t%REF\\t%ALT\\t[%GT]\\t%INFO/gnomAD_AF\\t%INFO/CLNSIG\\t%INFO/CLNREVSTAT\\t%INFO/ANN\\n' {input.vcf} > {output.tsv}"

rule summarize:
    input:
        tsv="results/annotation/variants_table.tsv",
        script="scripts/summarize_annotation.py"
    output:
        summary="results/annotation/variant_summary.tsv",
        report="results/annotation/annotation_report.txt"
    shell:
        "python {input.script} > {output.report}"