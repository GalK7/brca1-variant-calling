rule fastp:
    input:
        r1="data/na12878_R1.fastq.gz",
        r2="data/na12878_R2.fastq.gz"
    output:
        r1="results/trimmed/na12878_R1.trimmed.fastq.gz",
        r2="results/trimmed/na12878_R2.trimmed.fastq.gz",
        html="results/qc/fastp.html",
        json="results/qc/fastp.json"
    shell:
        "fastp -i {input.r1} -I {input.r2}   -o {output.r1} -O {output.r2}   --detect_adapter_for_pe   -h {output.html} -j {output.json}"